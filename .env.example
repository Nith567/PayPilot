# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas connection string (database name in the URI path)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pay-pilot?appName=Cluster0"

# Privy — create an app at https://dashboard.privy.io
# Enable Base Sepolia under "App settings → Networks"
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# Org signer key: app-held P-256 authorization key (base64 PKCS8, no PEM)
# registered in every org's key quorums — it signs intent authorizations.
# Generate: node -e "console.log(require('crypto').generateKeyPairSync('ec',{namedCurve:'P-256'}).privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
ORG_SIGNER_PRIVATE_KEY=""

# Network: base-sepolia (default) or base
NEXT_PUBLIC_CHAIN="base-sepolia"

# Gas sponsorship for payout intents. Requires TEE execution mode + the
# Privy dashboard "Gas sponsorship → App pays" setting. When false (default),
# org wallets pay gas from their own ETH balance.
NEXT_PUBLIC_SPONSOR_GAS="false"

# Optional: Privy webhook signing secret (dashboard → Configuration → Webhooks)
PRIVY_WEBHOOK_SECRET=""

# Cron secret for the scheduled-payout tick (Vercel sends it as Bearer token)
CRON_SECRET=""

# Resend (email notifications + inbound invoice webhook)
RESEND_API_KEY=""
RESEND_FROM="PayPilot <onboarding@resend.dev>"
RESEND_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
